{
  // Types only: nothing is emitted (esbuild builds the page, Node strips types for the tests). The JavaScript files stay
  // unchecked (checkJs off): src/main.js, src/startup-failure.js, the scripts and most unit tests; a .ts file that imports one reads its inferred types.
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "useDefineForClassFields": false,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  // xg_sync_test.ts runs inside xivgear's own checkout against their types, so it is left out
  "include": ["src/**/*.ts", "tests/**/*.ts"]
}
