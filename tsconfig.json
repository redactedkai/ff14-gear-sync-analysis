{
  // Types only: nothing is emitted (esbuild builds the page, Node strips types for the tests). The JavaScript files stay
  // unchecked (checkJs off): src/main.js, src/startup-failure.js and the few .js files kept on purpose under tests/ (tests/unit/scripts/typescript-only.test.ts); a .ts file that imports one reads its inferred types.
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "useDefineForClassFields": false,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "scripts/**/*.ts", "eslint.config.ts", "eslint-plugins.d.ts", ".claude/skills/**/*.ts"],
  // xg_sync_test.ts runs inside xivgear's own checkout against their types, so it is left out; the rest is build output
  "exclude": [
    "**/node_modules/**",
    "scripts/validate/xivgear/xg_sync_test.ts",
    "scripts/validate/out/**",
    "scripts/perf/out/**",
    "tests/stories/out/**",
    "tests/e2e/out/**"
  ]
}
