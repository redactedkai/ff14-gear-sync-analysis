{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  // .claude/settings.local.json is a per-machine file (gitignored) that Claude Code rewrites in its own layout, so it is
  // left out like the other generated or local files
  "files": {
    "includes": [
      "**",
      "!src/data",
      "!dist",
      "!data",
      "!node_modules",
      "!tests/e2e/out",
      "!tests/stories/out",
      "!tests/visual/test-results",
      "!scripts/perf/out",
      "!scripts/validate/out",
      "!package-lock.json",
      "!docs/scratchpad",
      "!.claude/worktrees",
      "!.claude/settings.local.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 140,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "arrowParentheses": "asNeeded",
      "trailingCommas": "all"
    }
  },
  // HTML is off except src/index.html (the boot shell and the one page element; see the overrides): the docs' diagrams are .svg
  // files that Biome would also read as HTML, and they keep their own layout (docs/diagrams/STYLE.md).
  "html": {
    "formatter": { "enabled": false },
    "linter": { "enabled": false }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noImportantStyles": "off",
        "noImplicitCoercions": "error"
      },
      "correctness": {
        "noUnusedVariables": "error"
      },
      "style": {
        "useTemplate": "off",
        "useBlockStatements": "error",
        "useConst": "error",
        "noUselessElse": "error",
        "noNestedTernary": "error",
        "noParameterAssign": "error",
        "useImportType": "error"
      },
      "suspicious": {
        "noVar": "error",
        "noDoubleEquals": "error",
        "noShadow": "error",
        "noExplicitAny": "error"
      }
    }
  },
  // xg_sync_test.ts runs inside xivgear's own test runner against their types (scripts/validate/xivgear/run.py copies
  // it there), so its loose `any` types and import style stay as they are; it is still format-checked.
  "overrides": [
    {
      // console is for src/ only: scripts and tests print on purpose (noConsole is off everywhere else)
      "includes": ["src/**/*.js", "src/**/*.ts"],
      "linter": { "rules": { "suspicious": { "noConsole": "error" } } }
    },
    {
      // the boot shell's tab names are <a> with no href on purpose: they are not links, only a stand-in drawn until the page starts
      "includes": ["src/index.html"],
      "html": { "formatter": { "enabled": true }, "linter": { "enabled": true } },
      "linter": { "rules": { "a11y": { "useValidAnchor": "off" } } }
    },
    {
      // no type assertion (`as`) in the core: the compiler checks the code instead. A cast that has to stay carries a
      // "ignore" comment that says why and which test checks it (src/core/guards.ts holds the typed helpers)
      "includes": ["src/core/**/*.ts"],
      "plugins": ["./biome-rules/no-type-assertion.grit"]
    },
    {
      "includes": ["scripts/validate/xivgear/xg_sync_test.ts"],
      "linter": { "enabled": false }
    },
    {
      // the startup-failure script is a classic ES5 script (it must run in a browser too old for the rest): function
      // expressions, var, a catch variable and no optional chaining are the point, not style slips: it is ES5 on
      // purpose, see the file header
      "includes": ["src/startup-failure.js"],
      "linter": {
        "rules": {
          "complexity": { "useArrowFunction": "off", "useOptionalChain": "off" },
          "correctness": { "noInnerDeclarations": "off", "noUnusedVariables": "off" },
          "suspicious": { "noVar": "off" }
        }
      }
    }
  ],
  "assist": {
    "actions": { "source": { "organizeImports": "off" } }
  }
}
