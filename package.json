{
  "name": "ff14-gear-sync-analysis",
  "version": "0.1.0",
  "private": true,
  "description": "Item level sync calculator and gear optimizer for FFXIV (single-file HTML page)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build/build.mjs",
    "dev": "node scripts/build/dev.mjs",
    "test": "node --test \"tests/unit/*.test.js\"",
    "test:py": "python -m unittest discover -s tests/data -p \"test_*.py\"",
    "smoke": "python tests/e2e/smoke.py",
    "lint": "biome lint . && python -m ruff check .",
    "format": "biome format --write . && python -m ruff format .",
    "format:check": "biome format . && python -m ruff format --check .",
    "check": "npm run lint && npm run format:check && npm run build && npm test && npm run test:py && npm run smoke",
    "fetch": "python scripts/data/fetch.py",
    "regen": "python scripts/data/regen.py"
  },
  "license": "MIT",
  "dependencies": {
    "alpinejs": "3.17.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "esbuild": "0.28.2"
  }
}
