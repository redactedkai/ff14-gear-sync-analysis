{
  "name": "ff14-gear-sync-analysis",
  "version": "0.1.0",
  "private": true,
  "description": "Item level sync calculator and gear optimizer for FFXIV (single-file HTML page)",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "node scripts/build/build.ts",
    "dev": "node scripts/build/dev.ts",
    "test": "node --test \"tests/unit/**/*.test.js\" \"tests/unit/**/*.test.ts\"",
    "test:fast": "node scripts/test.ts --fast",
    "test:full": "node --test \"tests/unit/**/*.test.js\" \"tests/unit/**/*.test.ts\" \"tests/sweep/*.test.js\"",
    "test:py": "node scripts/py.ts -m unittest discover -s tests/data -p \"test_*.py\"",
    "test:smoke": "node tests/e2e/smoke.ts",
    "test:model": "node scripts/test.ts --domain model",
    "test:data": "node scripts/test.ts --domain data --py",
    "test:solver": "node scripts/test.ts --domain solver",
    "test:auto-fill": "node scripts/test.ts --domain auto-fill",
    "test:set-page": "node scripts/test.ts --domain set-page",
    "test:sheets": "node scripts/test.ts --domain sheets",
    "test:gear-browser": "node scripts/test.ts --domain gear-browser",
    "test:math-page": "node scripts/test.ts --domain math-page",
    "test:app": "node scripts/test.ts --domain app",
    "test:look": "node scripts/test.ts --domain look",
    "test:tooling": "node scripts/test.ts --domain tooling",
    "test:changed": "node scripts/test.ts --changed",
    "lint": "biome lint --error-on-warnings . && biome format . && npm run lint:lit",
    "lint:py": "node scripts/py.ts -m ruff check . && node scripts/py.ts -m ruff format --check . && node scripts/py.ts -m pyrefly check",
    "format": "biome format --write .",
    "format:py": "node scripts/py.ts -m ruff format .",
    "check": "node scripts/check-deps.ts && npm run lint && npm run typecheck && npm run build && npm test && npm run test:stories && npm run test:smoke",
    "check:all": "npm run check && npm run test:stories:all && npm run lint:py && npm run test:py",
    "data:update": "node scripts/py.ts scripts/data/fetch.py && node scripts/py.ts scripts/data/regen.py",
    "data:verify": "node scripts/py.ts scripts/data/verify.py",
    "perf": "node scripts/perf/bench.mjs --quick --repeats 1",
    "perf:full": "node scripts/perf/bench.mjs --repeats 3",
    "perf:adversarial": "node scripts/perf/adversarial.mjs",
    "perf:browser": "npm run build && node scripts/perf/browser.mjs",
    "shots": "node scripts/shots/shots.ts",
    "shots:compare": "node scripts/shots/compare.ts",
    "stress:layout": "node scripts/layout-stress/index.mjs",
    "typecheck": "tsc --noEmit",
    "lint:lit": "eslint --max-warnings 0 --no-error-on-unmatched-pattern src/ui/elements",
    "test:stories": "node tests/stories/build.ts && playwright test --config tests/stories/playwright.config.ts --project chromium",
    "test:stories:all": "node tests/stories/build.ts && playwright test --config tests/stories/playwright.config.ts",
    "test:visual": "node scripts/visual.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@zag-js/collapsible": "1.49.0",
    "@zag-js/combobox": "1.49.0",
    "@zag-js/core": "1.49.0",
    "@zag-js/dialog": "1.49.0",
    "@zag-js/menu": "1.49.0",
    "@zag-js/popover": "1.49.0",
    "@zag-js/select": "1.49.0",
    "@zag-js/tabs": "1.49.0",
    "@zag-js/vanilla": "1.49.0",
    "lit": "3.3.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^22.20.5",
    "axe-core": "4.14.1",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "eslint-plugin-lit": "2.3.1",
    "eslint-plugin-lit-a11y": "5.1.3",
    "playwright": "1.64.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0"
  }
}
