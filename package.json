{
  "name": "ff14-gear-sync-analysis",
  "version": "0.1.0",
  "private": true,
  "description": "Item level sync calculator and gear optimizer for FFXIV (single-file HTML page)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build/build.mjs",
    "dev": "node scripts/build/dev.mjs",
    "test": "node --test \"tests/unit/**/*.test.js\"",
    "test:fast": "node scripts/test.mjs --fast",
    "test:full": "node --test \"tests/unit/**/*.test.js\" \"tests/sweep/*.test.js\"",
    "test:py": "node scripts/py.mjs -m unittest discover -s tests/data -p \"test_*.py\"",
    "test:smoke": "node tests/e2e/smoke.mjs",
    "test:model": "node scripts/test.mjs --domain model",
    "test:data": "node scripts/test.mjs --domain data --py",
    "test:solver": "node scripts/test.mjs --domain solver",
    "test:auto-fill": "node scripts/test.mjs --domain auto-fill",
    "test:set-page": "node scripts/test.mjs --domain set-page",
    "test:sheets": "node scripts/test.mjs --domain sheets",
    "test:gear-browser": "node scripts/test.mjs --domain gear-browser",
    "test:math-page": "node scripts/test.mjs --domain math-page",
    "test:app": "node scripts/test.mjs --domain app",
    "test:look": "node scripts/test.mjs --domain look",
    "test:tooling": "node scripts/test.mjs --domain tooling",
    "test:changed": "node scripts/test.mjs --changed",
    "lint": "biome lint --error-on-warnings . && biome format . && npm run lint:lit",
    "lint:py": "node scripts/py.mjs -m ruff check . && node scripts/py.mjs -m ruff format --check .",
    "format": "biome format --write .",
    "format:py": "node scripts/py.mjs -m ruff format .",
    "check": "node scripts/check-deps.mjs && npm run lint && npm run build && npm test && npm run test:smoke",
    "check:all": "npm run check && npm run lint:py && npm run test:py",
    "data:update": "node scripts/py.mjs scripts/data/fetch.py && node scripts/py.mjs scripts/data/regen.py",
    "perf": "node scripts/perf/bench.mjs --quick --repeats 1",
    "perf:full": "node scripts/perf/bench.mjs --repeats 3",
    "perf:adversarial": "node scripts/perf/adversarial.mjs",
    "perf:browser": "npm run build && node scripts/perf/browser.mjs",
    "shots": "node scripts/shots/shots.mjs",
    "shots:compare": "node scripts/shots/compare.mjs",
    "stress:layout": "node scripts/layout-stress/index.mjs",
    "typecheck": "node -e \"console.log('typecheck: nothing yet')\"",
    "lint:lit": "eslint --max-warnings 0 --no-error-on-unmatched-pattern src/ui/elements",
    "test:stories": "node -e \"console.log('test:stories: nothing yet')\"",
    "test:stories:all": "node -e \"console.log('test:stories:all: nothing yet')\"",
    "test:visual": "node -e \"console.log('test:visual: nothing yet')\""
  },
  "license": "MIT",
  "dependencies": {
    "@zag-js/collapsible": "1.49.0",
    "@zag-js/combobox": "1.49.0",
    "@zag-js/dialog": "1.49.0",
    "@zag-js/menu": "1.49.0",
    "@zag-js/popover": "1.49.0",
    "@zag-js/select": "1.49.0",
    "@zag-js/tabs": "1.49.0",
    "@zag-js/vanilla": "1.49.0",
    "alpinejs": "3.17.4",
    "lit": "3.3.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@vue/reactivity": "3.5.43",
    "axe-core": "4.14.1",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "eslint-plugin-lit": "2.3.1",
    "eslint-plugin-lit-a11y": "5.1.3",
    "playwright": "1.64.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0"
  }
}
